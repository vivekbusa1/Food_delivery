# Copy this file to .env and adjust values for your environment.
# Expo automatically inlines any variable prefixed with EXPO_PUBLIC_ into the JS bundle.

# Base URL of the backend REST API (must include the version prefix).
# - iOS simulator / web / physical device on same LAN as your computer: http://localhost:5000/api/v1
# - Android emulator (AVD) cannot reach "localhost" of your Mac/PC, it must use the special
#   alias 10.0.2.2 which routes to your host machine, e.g. http://10.0.2.2:5000/api/v1
# - Physical device: use your computer's LAN IP, e.g. http://192.168.1.10:5000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:5001/api/v1

# Google Maps API key used for react-native-maps on Android (also set in app.json).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Toggle verbose network/query logging in dev tools.
EXPO_PUBLIC_DEBUG=true
