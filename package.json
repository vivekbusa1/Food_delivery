{
  "name": "food-delivery",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Food Delivery Platform (Zomato/Swiggy style)",
  "workspaces": [
    "backend",
    "admin-panel",
    "restaurant-panel"
  ],
  "scripts": {
    "backend": "npm run dev --workspace=backend",
    "backend:start": "npm run start --workspace=backend",
    "backend:seed": "npm run seed --workspace=backend",
    "admin": "npm run dev --workspace=admin-panel",
    "restaurant": "npm run dev --workspace=restaurant-panel",
    "mobile": "npm start --prefix mobile-app",
    "docker:up": "docker-compose up -d --build",
    "docker:down": "docker-compose down",
    "install:all": "npm install && npm install --prefix mobile-app"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Food Delivery Team",
  "license": "MIT"
}
